# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real credentials.

# ---- Telegram application (required) ----
# From @BotFather
BOT_TOKEN=
# From https://my.telegram.org (only needed by optional userbot tooling)
API_ID=
API_HASH=
# Your numeric Telegram user ID (from @userinfobot)
OWNER_ID=

# ---- Access & channels ----
# true  -> anyone may use the bot (subject to the force-subscribe gate)
# false -> only the owner and stored admins
PUBLIC_MODE=true
ADMIN_USERNAME=@YourAdminUsername
MAIN_CHANNEL=@YourMainChannel
# Force-subscribe target. Leave FSUB_CHANNEL empty to disable the gate.
# If FSUB_CHANNEL is set, FSUB_LINK must be a valid https://t.me/... invite.
FSUB_CHANNEL=
FSUB_LINK=

# ---- Assets & diagnostics ----
START_PIC=assets/start.jpg
FSUB_PIC=assets/fsub.jpg
LOG_CHANNEL=0

# ---- Storage ----
# mongodb | sqlite
DATABASE_TYPE=sqlite
# Required only when DATABASE_TYPE=mongodb
MONGO_URI=
DATABASE_NAME=caption_bot
SQLITE_DATABASE=data/bot.db

# ---- Attribution ----
PROJECT_CREDIT=https://github.com/Ap-Loveris
